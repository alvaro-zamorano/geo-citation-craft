# Copia este fichero a .env y rellena los valores. .env esta en .gitignore:
# no lo comitees. Los valores reales de produccion viven en Vercel
# (Project Settings -> Environment Variables), no aqui.

# ── Cliente (se empaquetan en el bundle del navegador: NUNCA pongas aqui
#    nada que no pueda ser publico) ──────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Servidor (api/*). Estas si son secretas ───────────────────────────────
# Supabase con service role: salta RLS, lee y escribe todo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: checkout (api/checkout.ts) y webhook (api/stripe-webhook.ts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend: entrega de PDFs, secuencia de email y aviso de escaneo.
RESEND_API_KEY=
OWNER_EMAIL=

# Panel de admin (api/admin/auth.ts) y cron de Vercel (api/email-sequence.ts).
ADMIN_TOKEN=
CRON_SECRET=

# Opcionales: metricas del panel y Search Console.
GITHUB_ADMIN_TOKEN=
GSC_SERVICE_ACCOUNT_JSON=
